      "vulnerability_scanning": {
        "default": "mdi:shield-search"
      },
      "update_checks": {
        "default": "mdi:update"
      },
      "auto_update": {
        "default": "mdi:arrow-up-circle-outline"
      },
      "image_pruning": {
        "default": "mdi:broom"
      }
    },
    "switch": {
      "running": {
        "default": "mdi:docker"
      },
      "stack": {
        "default": "mdi:layers-triple"
      }
    },
    "button": {
      "restart": {
        "default": "mdi:restart"
